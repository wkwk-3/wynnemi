{
  "schemaVersion": 1,
  "id": "emi",
  "version": "${version}",
  "name": "Wynn EMI Core (EMI fork)",
  "description": "EMI fork used by Wynn EMI. Based on PF-EMI (ProjectFlint) and EMI by Emi. Adds search extension hooks.",
  "authors": [
    "Emi"
  ],
  "contributors": [
    "ProjectFlint"
  ],
  "contact": {
    "sources": "https://github.com/wkwk-3/wynnemi"
  },
  "license": "MIT",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.emi.emi.platform.fabric.EmiMainFabric"
    ],
    "client": [
      "dev.emi.emi.platform.fabric.EmiClientFabric"
    ],
    "server": [],
    "emi": [
      "dev.emi.emi.VanillaPlugin",
      "dev.emi.emi.ProjectFlintPlugin"
    ],
    "modmenu": [
      "dev.emi.emi.compat.EmiModMenu"
    ],
    "jei_mod_plugin": [
      "dev.emi.emi.jemi.JemiPlugin"
    ]
  },
  "custom": {
    "polymer:disable_mixin": {
      "polymer-core:client.compat.emi_ItemEmiStackMixin": "Please stop mixing into impl"
    }
  },
  "mixins": [
    "emi.mixins.json",
    "emi-fabric.mixins.json"
  ],
  "accessWidener": "emi.accesswidener",
  "depends": {
    "fabricloader": ">=0.19.3",
    "fabric": "*",
    "minecraft": "1.21.11"
  },
  "provides": [
    "wynnemi_emi"
  ]
}
