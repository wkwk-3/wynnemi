{
  "schemaVersion": 1,
  "id": "wei",
  "version": "${version}",
  "name": "WEI",
  "description": "Wynn Enough Items: a JEI/EMI-style item viewer for Wynncraft. Browse and search every item, and look up where it comes from and what it is used for. Uses Wynntils data and a bundled EMI fork.",
  "authors": [
    "wkwk"
  ],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "io.github.wkwk.wei.Wei"
    ],
    "emi": [
      "io.github.wkwk.wei.emi.WeiEmiPlugin"
    ],
    "modmenu": [
      "io.github.wkwk.wei.config.WeiModMenu"
    ]
  },
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=21",
    "fabric-api": "*",
    "wynntils": "*",
    "wei_emi": "*"
  },
  "mixins": [
    "wei.mixins.json"
  ],
  "contact": {
    "sources": "https://github.com/wkwk-3/wynnemi",
    "issues": "https://github.com/wkwk-3/wynnemi/issues"
  },
  "suggests": {
    "wynnventory": "*"
  }
}
