{
  "schemaVersion": 1,
  "id": "wynnemi",
  "version": "${version}",
  "name": "Wynn EMI",
  "description": "Shows Wynncraft items from Wynntils in EMI, with where-to-obtain and profession-use recipes.",
  "authors": ["wkwk"],
  "license": "LGPL-3.0-only",
  "environment": "client",
  "entrypoints": {
    "client": ["io.github.wkwk.wynnemi.WynnEmiClient"],
    "emi": ["io.github.wkwk.wynnemi.emi.WynnEmiPlugin"]
  },
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=21",
    "fabric-api": "*",
    "wynntils": "*",
    "emi": "*"
  }
}
