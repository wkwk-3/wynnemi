{
  "schemaVersion": 1,
  "id": "wynncodex",
  "version": "${version}",
  "name": "WynnCodex",
  "description": "An in-game Wynncraft item codex: browse, search and look up where every item comes from, powered by Wynntils data and a bundled EMI fork.",
  "authors": [
    "wkwk"
  ],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "io.github.wkwk.wynncodex.WynnCodex"
    ],
    "emi": [
      "io.github.wkwk.wynncodex.emi.WynnCodexEmiPlugin"
    ]
  },
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=21",
    "fabric-api": "*",
    "wynntils": "*",
    "wynncodex_emi": "*"
  },
  "mixins": [
    "wynncodex.mixins.json"
  ],
  "contact": {
    "sources": "https://github.com/wkwk-3/wynnemi",
    "issues": "https://github.com/wkwk-3/wynnemi/issues"
  }
}
